<Window x:Class="DoubaoComputerUse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="豆包电脑控制设置"
        Width="1180"
        Height="720"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="豆包电脑控制"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Border Margin="10,0,0,0"
                                Padding="9,2"
                                CornerRadius="12"
                                BorderThickness="1"
                                Background="#F0FDF4"
                                BorderBrush="{Binding ServiceState, Converter={StaticResource StateBrushConverter}}">
                            <TextBlock Text="{Binding ServiceStateText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ServiceState, Converter={StaticResource StateBrushConverter}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ServiceSummary}"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="检查"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="启动"
                            Command="{Binding StartServicesCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,14,0" />
                    <Button Content="—"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="Minimize_OnClick"
                            Margin="0,0,6,0" />
                    <Button Content="□"
                            Style="{StaticResource WindowButtonStyle}"
                            Click="MaximizeRestore_OnClick"
                            Margin="0,0,6,0" />
                    <Button Content="×"
                            Style="{StaticResource WindowButtonStyle}"
                            Background="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}"
                            Foreground="White"
                            Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="356" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="运行任务" Style="{StaticResource SectionTitleStyle}" />

                            <TextBlock Text="模型" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Models}"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,14" />

                            <TextBlock Text="任务" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding TaskPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     MinHeight="112"
                                     Margin="0,0,0,14" />

                            <CheckBox IsChecked="{Binding AutoStartEnabled}"
                                      Content="打开时自动启动本地服务"
                                      Margin="0,0,0,12" />

                            <Expander Header="高级指令"
                                      Margin="0,0,0,14">
                                <TextBox Text="{Binding SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         MinHeight="108" />
                            </Expander>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="运行"
                                        Command="{Binding RunTaskCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="2"
                                        Content="停止"
                                        Command="{Binding StopTaskCommand}" />
                                <Button Grid.Column="4"
                                        Content="清空"
                                        Command="{Binding ClearTraceCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="本地服务" Style="{StaticResource SmallSectionTitleStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LastCheckedText}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding State, Converter={StaticResource StateBrushConverter}}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,9,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StateText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="屏幕标记调试"
                                      Margin="0,6,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="X 坐标" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding OverlayX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Y 坐标" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding OverlayY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="持续时间" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding OverlayDurationMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="半径" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding OverlayRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="显示" Command="{Binding ShowOverlayCommand}" />
                                        <Button Grid.Column="2" Content="隐藏" Command="{Binding HideOverlayCommand}" />
                                        <Button Grid.Column="4" Content="自检" Command="{Binding OverlaySelfTestCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图预览" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ServiceStateText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{StaticResource PreviewBrush}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding LatestScreenshot}"
                                       Stretch="Uniform"
                                       Visibility="{Binding LatestScreenshot, Converter={StaticResource NullToVisibilityConverter}}" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding LatestScreenshot, Converter={StaticResource NullToHiddenConverter}}">
                                    <TextBlock Text="等待画面"
                                               Foreground="#DDE7F2"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="运行任务后显示最新截图"
                                               Foreground="#8EA0B6"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="运行记录" Style="{StaticResource SectionTitleStyle}" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Trace}"
                                     SelectedItem="{Binding SelectedTrace, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelMutedBrush}"
                                                CornerRadius="6"
                                                Padding="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Fill="{Binding IsError, Converter={StaticResource StateBrushConverter}}"
                                                         Margin="0,5,9,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TimeText}"
                                                           Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding Detail}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           MaxHeight="44"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="记录详情" Style="{StaticResource SectionTitleStyle}" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding SelectedTraceDetail, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     FontFamily="Cascadia Mono, Consolas"
                                     FontSize="12" />
                            <Expander Grid.Row="2"
                                      Header="原始数据"
                                      Margin="0,12,0,0">
                                <TextBox Text="{Binding SelectedTraceJson, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         MinHeight="110" />
                            </Expander>
                            <Expander Grid.Row="3"
                                      Header="运行时诊断"
                                      Margin="0,8,0,0">
                                <TextBox Text="{Binding DiagnosticText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         MinHeight="96" />
                            </Expander>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
