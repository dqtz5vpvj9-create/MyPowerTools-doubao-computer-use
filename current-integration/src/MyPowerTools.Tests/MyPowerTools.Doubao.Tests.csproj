<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <MyPowerToolsRepoRoot Condition="'$(MyPowerToolsRepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\..</MyPowerToolsRepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MyPowerToolsRepoRoot)\src\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
    <ProjectReference Include="$(MyPowerToolsRepoRoot)\src\MyPowerTools.Shell.Avalonia\MyPowerTools.Shell.Avalonia.csproj" />
    <ProjectReference Include="..\DoubaoAgent.MyPowerTools\DoubaoAgent.MyPowerTools.csproj"
                      AdditionalProperties="MyPowerToolsRepoRoot=$(MyPowerToolsRepoRoot)" />
  </ItemGroup>

</Project>
